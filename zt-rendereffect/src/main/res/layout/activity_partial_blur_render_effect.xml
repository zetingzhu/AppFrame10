<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下半部分高斯模糊"
            android:textColor="#FF111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="当前页面只对图片下半部分应用高斯模糊，上半部分保持原图显示。"
            android:textColor="#FF4B5563"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="分区效果预览"
            android:textColor="#FF111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:background="#FFE5E7EB">

            <ImageView
                android:id="@+id/image_origin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="原图"
                android:scaleType="centerCrop"
                android:src="@mipmap/guide_trade_audio_stop_big" />

            <ImageView
                android:id="@+id/image_bottom_blur"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_gravity="bottom"
                android:contentDescription="下半部分模糊图"
                android:scaleType="centerCrop"
                android:src="@mipmap/guide_trade_audio_stop_big" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="模糊半径"
            android:textColor="#FF111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_radius_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="18 px"
            android:textColor="#FF2563EB"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_bar_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="40"
            android:progress="18" />

    </LinearLayout>
</ScrollView>
