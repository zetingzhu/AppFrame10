<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_touch_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/image_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="背景原图"
        android:scaleType="centerCrop"
        android:src="@mipmap/guide_trade_audio_stop_big" />

    <com.trade.zt_rendereffect.CircularBlurImageView
        android:id="@+id/image_blur_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="圆形模糊图层"
        android:scaleType="centerCrop"
        android:src="@mipmap/guide_trade_audio_stop_big" />

    <com.trade.zt_rendereffect.SpotlightOverlayView
        android:id="@+id/view_spotlight_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="触摸圆形毛玻璃"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#33000000"
            android:padding="12dp"
            android:text="按住并移动手指，圆形半透明区域下方会显示高斯模糊效果。"
            android:textColor="#FFF3F4F6"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
